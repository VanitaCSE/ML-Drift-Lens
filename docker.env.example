# Required: set a local secret before starting Compose.
POSTGRES_PASSWORD=replace_with_your_local_database_password

# Optional published ports.
HOST_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=25432
REDIS_PORT=26380
MLFLOW_PORT=25000
INFERENCE_PORT=28000
BACKEND_PORT=23000
FRONTEND_PORT=25173

# Optional runtime settings.
POSTGRES_DB=ml_drift_lens
POSTGRES_USER=postgres
ML_SERVICE_TIMEOUT=15000
LOG_LEVEL=INFO
MLFLOW_REGISTERED_MODEL_NAME=ModelWatch-IDS-Baseline
CORS_ORIGINS=http://localhost:25173,http://127.0.0.1:25173
NODE_ENV=development
DATABASE_URL=
DATABASE_SSL=false
SESSION_SECRET=replace_with_at_least_32_random_bytes
SESSION_COOKIE_SECURE=false

# Open first-party account registration; protected lifecycle operations remain blocked until policy is approved.
VERIFIED_LABEL_SOURCE_ALLOWLIST=

# Render staging deployment client is disabled until a staging-only target and API key are configured.
RENDER_TARGET_ENVIRONMENT=
RENDER_STAGING_SERVICE_ID=
RENDER_API_KEY=
