# Optional browser-visible API origin. Leave empty to use the same-origin Vite proxy.
VITE_API_URL=
# Vite proxy upstream for local development (native backend defaults to port 3000;
# the default local Compose backend is published on port 23000).
VITE_API_PROXY_TARGET=http://localhost:3000
# Minimum accepted value is 5000 ms; invalid values use the 30000 ms default.
VITE_DASHBOARD_REFRESH_INTERVAL_MS=30000
