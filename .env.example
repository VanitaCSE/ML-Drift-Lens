# Example environment configuration for ML-Drift-Lens
# Never put real passwords, API keys, or tokens in this file.
# Copy this file to .env and fill in real values for local development.

# ==========================================
# Docker Compose PostgreSQL configuration
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_your_local_database_password
POSTGRES_DB=ml_drift_lens

# ==========================================
# PostgreSQL Database Configuration (local dev)
# ==========================================
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_database_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ml_drift_lens

# ==========================================
# Published ports (Docker Compose)
# ==========================================
HOST_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=25432
REDIS_PORT=26380
MLFLOW_PORT=25000
INFERENCE_PORT=28000
BACKEND_PORT=23000
FRONTEND_PORT=25173

# ==========================================
# MLflow Configuration
# ==========================================
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=ModelWatch-IDS
MLFLOW_REGISTERED_MODEL_NAME=ModelWatch-IDS-Baseline

# ==========================================
# Node.js Backend Configuration
# ==========================================
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=
DATABASE_SSL=false
SESSION_SECRET=replace_with_at_least_32_random_bytes
SESSION_COOKIE_SECURE=false

# ==========================================
# Redis Configuration
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# ML Service Configuration
# ==========================================
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=5000

# ==========================================
# Inference Service Configuration
# ==========================================
INFERENCE_HOST=127.0.0.1
INFERENCE_PORT=8000
MODEL_ARTIFACT_PATH=ml/artifacts/model.joblib
LOG_LEVEL=INFO

# ==========================================
# Frontend Configuration
# ==========================================
VITE_API_URL=http://localhost:3000

# ==========================================
# Drift Monitoring
# ==========================================
DRIFT_RETRAINING_ENABLED=false

# Trusted labels remain unavailable until an authoritative ingestion process is selected.
# Comma-separated source identifiers are an administrative allowlist, not proof by themselves.
VERIFIED_LABEL_SOURCE_ALLOWLIST=

# Render deployment client stays disabled unless the exact staging target is explicitly configured.
RENDER_TARGET_ENVIRONMENT=
RENDER_STAGING_SERVICE_ID=
RENDER_API_KEY=
